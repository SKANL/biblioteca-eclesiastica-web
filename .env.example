# API base URL (public, read at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: base URL used by tests/tools/check-routing-regressions.mjs
# WEB_BASE_URL=http://127.0.0.1:3010

# --- Editor login (Auth.js v5 + Google). All optional: without them the login
# button is hidden and public reading keeps working.
# Auth.js session-cookie secret (PWA only). Generate: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed for `next start` on localhost (Vercel sets it automatically).
# AUTH_TRUST_HOST=true

# Shared HS256 secret used to mint short-lived API tokens (server-only).
# MUST equal the API's AUTH_SECRET (pipeline-OCR .env). Different from the
# PWA's AUTH_SECRET above on purpose: one secret per purpose.
API_AUTH_SECRET=
# Server-side API base URL (optional; falls back to NEXT_PUBLIC_API_BASE_URL)
# API_BASE_URL=http://localhost:8000

# Local-only dev login (never on Vercel: it is ignored when VERCEL is set).
# Lets you enter the editor area without Google; emails must also be editors in the API (ADMIN_EMAILS).
AUTH_DEV_LOGIN=false
AUTH_DEV_EMAILS=
